<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="inventario" pageWidth="595" pageHeight="842" columnWidth="535"
              leftMargin="30" rightMargin="30" topMargin="20" bottomMargin="20">

    <field name="producto" class="java.lang.String"/>
    <field name="sucursal" class="java.lang.String"/>
    <field name="stock" class="java.lang.Integer"/>

    <title>
        <band height="35">
            <staticText>
                <reportElement x="0" y="0" width="300" height="30"/>
                <textElement><font size="16" isBold="true"/></textElement>
                <text><![CDATA[Reporte de Inventario]]></text>
            </staticText>
        </band>
    </title>

    <columnHeader>
        <band height="22">
            <staticText><reportElement x="0" y="0" width="225" height="22" mode="Opaque" backcolor="#EEEEEE"/><text><![CDATA[Producto]]></text></staticText>
            <staticText><reportElement x="225" y="0" width="225" height="22" mode="Opaque" backcolor="#EEEEEE"/><text><![CDATA[Sucursal]]></text></staticText>
            <staticText><reportElement x="450" y="0" width="85" height="22" mode="Opaque" backcolor="#EEEEEE"/><text><![CDATA[Stock]]></text></staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="20">
            <textField><reportElement x="0" y="0" width="225" height="20"/><textFieldExpression><![CDATA[$F{producto}]]></textFieldExpression></textField>
            <textField><reportElement x="225" y="0" width="225" height="20"/><textFieldExpression><![CDATA[$F{sucursal}]]></textFieldExpression></textField>
            <textField><reportElement x="450" y="0" width="85" height="20"/><textFieldExpression><![CDATA[$F{stock}]]></textFieldExpression></textField>
        </band>
    </detail>
</jasperReport>
